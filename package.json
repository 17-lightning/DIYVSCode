{
  "name": "diyvscode",
  "displayName": "diyvscode",
  "description": "DIY your vscode without pain",
  "publisher": "ltn",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.40.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "DIYVSCode.helloWorld",
        "title": "打开DIY页面"
      },
      {
        "command": "DIYVSCode.diyJump",
        "title": "DIY跳转"
      },
      {
        "command": "DIYVSCode.paint_it",
        "title": "DIY绘制"
      },
      {
        "command": "DIYVSCode.test_it",
        "title": "DIY测试"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == c || resourceLangId == cpp",
          "command": "DIYVSCode.diyJump",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == c || resourceLangId == cpp",
          "command": "DIYVSCode.paint_it",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == c || resourceLangId == cpp",
          "command": "DIYVSCode.test_it",
          "group": "navigation"
        }
      ]
    },
    "configuration":[
      {
        "title": "object",
        "properties": {
          "diyvscode.diyjumpconfig": {
            "type": "string",
            "default": "",
            "description": "指定DIY跳转的配置文件"
          }
        }
      },
      {
        "title": "object",
        "properties": {
          "diyvscode.diyjumptoppath": {
            "type": "string",
            "default": "",
            "description": "指定DIY跳转的起始路径"
          }
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
