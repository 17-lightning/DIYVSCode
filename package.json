{
  "name": "diyvscode",
  "displayName": "diyvscode",
  "description": "DIY your vscode without pain",
  "publisher": "ltn",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.40.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/DIY-TOP.js",
  "contributes": {
    "commands": [
      {
        "command": "DIYVSCode.diyJump",
        "title": "DIY跳转"
      },
      {
        "command": "DIYVSCode.diybook",
        "title": "DIY归档"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == c || resourceLangId == cpp",
          "command": "DIYVSCode.diyJump",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == c || resourceLangId == cpp",
          "command": "DIYVSCode.diybook",
          "group": "navigation"
        }
      ]
    },
    "configuration":[
      {
        "title": "object",
        "properties": {
          "diyvscode.DiyJumpRules": {
            "type": "string",
            "default": "",
            "description": "你可以指定DIY跳转使用哪里的配置文件，但当前工作区下的规则总是优先生效"
          }
        }
      },
      {
        "title": "object",
        "properties": {
          "diyvscode.diyjumptoppath": {
            "type": "string",
            "default": "",
            "description": "指定DIY跳转的起始路径"
          }
        }
      },
      {
        "title": "object",
        "properties": {
          "diyvscode.DIYLibrary": {
            "type": "string",
            "default": "",
            "description": "指定DIY字典的归档路径"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "DIY-Dictionary",
          "title": "DIY字典",
          "icon": "Dictionary/svg.svg"
        }
      ]
    },
    "views": {
      "DIY-Dictionary": [
        {
          "id": "part1",
          "name": "part_one",
          "icon": "Dictionary/svg.svg"
        },
        {
          "id": "part2",
          "name": "part_two"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
